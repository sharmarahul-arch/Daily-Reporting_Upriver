# --- Secrets / per-user config (NEVER commit) ---
# Ignore EVERYTHING in config/ except the example templates, so a dropped-in
# service-account key (any filename), real credentials, and the accounts file
# can never be committed by accident.
config/*
!config/credentials.example.json
!config/accounts.example.xlsx
# Service-account JSON anywhere else in the tree, just in case
*service-account*.json
*sheet-bridge*.json
*.iam.gserviceaccount.json

# --- Per-user state ---
sessions/
downloads/
logs/

# --- Python ---
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Per-user tooling state ---
.claude/

# Generated shareable docs (regenerate anytime)
*.docx
*.pdf
